local TARGET_PLACE_ID = 136162036182779

-- Reload source after a teleport (serverhop / rejoin). Use ONE of these:
--  1) RELOAD_URL: raw link to this script (best, needs no file)
local RELOAD_URL = "https://raw.githubusercontent.com/mze222/GV2026H/refs/heads/main/Main"
local RELOAD_FILE = "HalloweenCandyFarm.lua"

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local genv = (getgenv and getgenv()) or _G

if game.PlaceId ~= TARGET_PLACE_ID then
    genv.HHF_STATE = nil
    return
end

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local VirtualUser = game:GetService("VirtualUser")
local StarterGui = game:GetService("StarterGui")

if genv.HHF_STOP then
    pcall(genv.HHF_STOP)
end

local player = Players.LocalPlayer

local enabled = false
local perfEnabled = false
local rejoinEnabled = false
local hopEnabled = false
local hopping = false
local rejoining = false
local visited = setmetatable({}, {__mode = "k"})
local fails = setmetatable({}, {__mode = "k"})
local priorityHouse = nil
local runId = 0
local guardConn = nil
local sitHum = nil
local servers = {}
local hop
local teleportFailed = false
local warnedNoReload = false

local saved = genv.HHF_STATE
genv.HHF_STATE = nil
if saved and saved.servers then
    for _, id in ipairs(saved.servers) do
        servers[#servers + 1] = id
    end
end
if not table.find(servers, game.JobId) then
    servers[#servers + 1] = game.JobId
end

local nameChars = {"I", "l", "1", "O", "0", "i", "o"}
local function randName()
    local s = {}
    for i = 1, math.random(24, 40) do
        s[i] = nameChars[math.random(1, #nameChars)]
    end
    return table.concat(s)
end

local function notify(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {Title = "Candy Farm", Text = text, Duration = 8})
    end)
end

local function getCharacter()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    return char, hum, root
end

local function isAlive()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0 and char:FindFirstChild("HumanoidRootPart") ~= nil
end

local function isHouseInstance(inst)
    return string.find(inst.Name, "^HalloweenHouse") ~= nil
end

local function serializeState()
    local list = {}
    for _, id in ipairs(servers) do
        list[#list + 1] = string.format("%q", id)
    end
    return string.format(
        "{farm=%s,rejoin=%s,hop=%s,perf=%s,servers={%s}}",
        tostring(enabled), tostring(rejoinEnabled),
        tostring(hopEnabled), tostring(perfEnabled), table.concat(list, ",")
    )
end

local function clearQueue()
    pcall(function()
        if clear_teleport_queue then
            clear_teleport_queue()
        end
    end)
end

local function canReload()
    if RELOAD_URL ~= "" then return true end
    if isfile then
        local ok, exists = pcall(isfile, RELOAD_FILE)
        return ok and exists == true
    end
    return false
end

local function queueReload()
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if not q then return end

    if not canReload() then
        if not warnedNoReload then
            warnedNoReload = true
            warn(("[HHF] No reload source: set RELOAD_URL or save the script as %q in your executor workspace folder. The farm will NOT restart after teleporting."):format(RELOAD_FILE))
            notify("Reload source missing (RELOAD_URL / " .. RELOAD_FILE .. ")")
        end
        return
    end

    local loader
    if RELOAD_URL ~= "" then
        loader = string.format("loadstring(game:HttpGet(%q))()", RELOAD_URL)
    else
        loader = string.format("loadstring(readfile(%q))()", RELOAD_FILE)
    end

    -- The place check runs BEFORE anything else, so the script never starts in other games.
    local code = string.format(
        "repeat task.wait() until game:IsLoaded()\n" ..
        "if game.PlaceId ~= %.0f then return end\n" ..
        "getgenv().HHF_STATE = %s\n" ..
        "local ok, err = pcall(function() %s end)\n" ..
        "if not ok then warn('[HHF] reload failed: ' .. tostring(err)) end",
        TARGET_PLACE_ID, serializeState(), loader
    )

    clearQueue()
    pcall(q, code)
end

local function guard()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    if hum ~= sitHum then
        sitHum = hum
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        end)
    end
    if hum.Sit then
        hum.Sit = false
        hum.Jump = true
    end

    if not char:FindFirstChild("FusionCoil") then
        local backpack = player:FindFirstChildOfClass("Backpack")
        local coil = backpack and backpack:FindFirstChild("FusionCoil")
        if coil then
            hum:EquipTool(coil)
        end
    end
end

local function startGuard()
    if guardConn then return end
    guardConn = RunService.Heartbeat:Connect(guard)
end

local function stopGuard()
    if guardConn then
        guardConn:Disconnect()
        guardConn = nil
    end
    if sitHum then
        pcall(function()
            sitHum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        end)
        sitHum = nil
    end
end

local function getPrompt(house)
    local plane = house:FindFirstChild("Plane.018", true)
    if plane then
        local pr = plane:FindFirstChildWhichIsA("ProximityPrompt", true)
        if pr then return pr end
        if plane.Parent then
            local sibling = plane.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
            if sibling then return sibling end
        end
    end
    return nil
end

local function promptPosition(prompt)
    local p = prompt.Parent
    if p and p:IsA("BasePart") then
        return p.Position
    elseif p and p:IsA("Attachment") then
        return p.WorldPosition
    end
    return nil
end

local function pickTarget()
    local _, _, root = getCharacter()

    if priorityHouse and priorityHouse.Parent == workspace and not visited[priorityHouse] then
        local pr = getPrompt(priorityHouse)
        if pr then
            local house = priorityHouse
            priorityHouse = nil
            return house, pr
        end
    end
    priorityHouse = nil

    local bestHouse, bestPrompt, bestDist
    for _, house in ipairs(workspace:GetChildren()) do
        if isHouseInstance(house) and not visited[house] then
            local pr = getPrompt(house)
            if pr then
                local pos = promptPosition(pr)
                if pos then
                    local d = (pos - root.Position).Magnitude
                    if not bestDist or d < bestDist then
                        bestHouse, bestPrompt, bestDist = house, pr, d
                    end
                end
            end
        end
    end
    return bestHouse, bestPrompt
end

local function flatDist(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function buildCandidates(pos)
    local _, _, root = getCharacter()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character}

    local list = {}
    for _, radius in ipairs({5, 7, 9}) do
        for angle = 0, 315, 45 do
            local rad = math.rad(angle)
            local p = pos + Vector3.new(math.cos(rad) * radius, 0, math.sin(rad) * radius)
            local res = workspace:Raycast(p + Vector3.new(0, 4, 0), Vector3.new(0, -60, 0), params)
            if res and res.Normal.Y > 0.7 then
                local score = (res.Position - root.Position).Magnitude + math.abs(res.Position.Y - root.Position.Y) * 2
                list[#list + 1] = {pos = res.Position, score = score}
            end
        end
    end

    table.sort(list, function(a, b)
        return a.score < b.score
    end)

    local out = {}
    for i = 1, math.min(#list, 8) do
        out[i] = list[i].pos
    end
    if #out == 0 then
        out[1] = pos
    end
    return out
end

local function turnIsSharp(waypoints, i)
    if i >= #waypoints then return false end
    local a = waypoints[i].Position - waypoints[i - 1].Position
    local b = waypoints[i + 1].Position - waypoints[i].Position
    a = Vector3.new(a.X, 0, a.Z)
    b = Vector3.new(b.X, 0, b.Z)
    if a.Magnitude < 0.1 or b.Magnitude < 0.1 then return false end
    return a.Unit:Dot(b.Unit) < 0.8
end

local function followPath(waypoints, goal, promptPos, activation, myRun, state)
    local _, hum, root = getCharacter()
    local count = #waypoints

    local i = 2
    local lastPos = root.Position
    local lastCheck = os.clock()
    local stuck = 0
    local started = os.clock()

    while i <= count do
        if not enabled or myRun ~= runId then return false end
        if state.blocked then return false end
        if hum.Health <= 0 or not root.Parent then return false end

        local wp = waypoints[i]
        state.index = i

        hum:MoveTo(wp.Position)

        if (root.Position - promptPos).Magnitude <= activation then
            return true
        end

        if wp.Action == Enum.PathWaypointAction.Jump and flatDist(root.Position, wp.Position) < 4.5 then
            hum.Jump = true
        end

        local reach
        if i == count then
            reach = 3
        elseif turnIsSharp(waypoints, i) then
            reach = 2
        else
            reach = 4.5
        end

        if flatDist(root.Position, wp.Position) <= reach then
            i += 1
            started = os.clock()
            stuck = 0
            lastPos = root.Position
            lastCheck = os.clock()
        else
            local now = os.clock()
            if now - lastCheck >= 0.25 then
                if (root.Position - lastPos).Magnitude < 0.35 then
                    stuck += 1
                    if stuck >= 3 then return false end
                else
                    stuck = 0
                end
                lastPos = root.Position
                lastCheck = now
            end
            if now - started > 7 then return false end
            RunService.Heartbeat:Wait()
        end
    end
    return flatDist(root.Position, goal) < 6
end

local function walkToPrompt(prompt, myRun)
    local promptPos = promptPosition(prompt)
    if not promptPos then return false end

    local _, _, root = getCharacter()
    local activation = math.max(prompt.MaxActivationDistance - 1.5, 4)
    if (root.Position - promptPos).Magnitude <= activation then
        return true
    end

    for _, cand in ipairs(buildCandidates(promptPos)) do
        for attempt = 1, 3 do
            if not enabled or myRun ~= runId or not isAlive() then return false end

            local path = PathfindingService:CreatePath({
                AgentRadius = 3 + attempt,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = false,
                WaypointSpacing = 5,
            })

            local ok = pcall(function()
                path:ComputeAsync(root.Position, cand)
            end)

            if ok and path.Status == Enum.PathStatus.Success then
                local state = {blocked = false, index = 2}
                local conn = path.Blocked:Connect(function(blockedIndex)
                    if blockedIndex >= state.index then
                        state.blocked = true
                    end
                end)
                local reached = followPath(path:GetWaypoints(), cand, promptPos, activation, myRun, state)
                conn:Disconnect()
                if reached then
                    return true
                end
            else
                break
            end
        end
    end
    return false
end

local function interact(prompt, myRun)
    task.wait(0.2 + math.random() * 0.3)
    pcall(function()
        prompt.RequiresLineOfSight = false
    end)

    local started = os.clock()
    local presses = 0
    while enabled and myRun == runId and presses < 15 and os.clock() - started < 10 do
        if not prompt.Parent or not prompt:IsDescendantOf(workspace) then break end
        if not prompt.Enabled then break end

        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            pcall(function()
                prompt:InputHoldBegin()
                task.wait(prompt.HoldDuration + 0.1)
                prompt:InputHoldEnd()
            end)
        end

        presses += 1
        task.wait(math.max(prompt.HoldDuration, 0) + 0.3)
    end
    task.wait(1)
end

local function mainLoop(myRun)
    local idleSince = nil
    while enabled and myRun == runId do
        if not isAlive() then
            task.wait(0.5)
            continue
        end

        local house, prompt = pickTarget()
        if house and prompt and prompt.Parent then
            idleSince = nil
            local arrived = walkToPrompt(prompt, myRun)
            if enabled and myRun == runId then
                if arrived and prompt.Parent then
                    interact(prompt, myRun)
                    visited[house] = true
                elseif isAlive() then
                    fails[house] = (fails[house] or 0) + 1
                    if fails[house] >= 3 then
                        visited[house] = true
                    end
                    task.wait(0.5)
                end
            end
        else
            if not idleSince then
                idleSince = os.clock()
            end
            if hopEnabled and os.clock() - idleSince >= 10 then
                hop()
                idleSince = os.clock()
            end
            task.wait(1)
        end
        task.wait(0.1)
    end
end

local houseConn = workspace.ChildAdded:Connect(function(child)
    if isHouseInstance(child) then
        task.wait(1)
        visited[child] = nil
        fails[child] = nil
        priorityHouse = child
    end
end)

local tpFailConn = TeleportService.TeleportInitFailed:Connect(function(plr)
    if plr == player then
        teleportFailed = true
    end
end)

-- returns list (or nil), statusCode
local function fetchServers()
    local req = (syn and syn.request) or http_request or request or (http and http.request)
    if not req then return nil end
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true",
        game.PlaceId
    )
    local ok, res = pcall(req, {Url = url, Method = "GET"})
    if not ok or not res then return nil end
    if res.StatusCode == 429 then return nil, 429 end
    if not res.Body then return nil, res.StatusCode end
    local ok2, data = pcall(function()
        return HttpService:JSONDecode(res.Body)
    end)
    if ok2 and data and data.data then
        return data.data, res.StatusCode
    end
    return nil, res.StatusCode
end

hop = function()
    if hopping then return end
    hopping = true
    task.spawn(function()
        while hopEnabled and enabled do
            local list, status = fetchServers()
            local choices = {}
            if list then
                for _, s in ipairs(list) do
                    if s.id ~= game.JobId and (s.playing or 0) < (s.maxPlayers or 0) and not table.find(servers, s.id) then
                        choices[#choices + 1] = s
                    end
                end
            end

            if #choices > 0 then
                local pick = choices[math.random(1, #choices)]
                servers[#servers + 1] = pick.id
                if #servers > 40 then
                    table.remove(servers, 1)
                end
                teleportFailed = false
                queueReload()
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, player)
                end)
                local t0 = os.clock()
                while hopEnabled and enabled and os.clock() - t0 < 15 and not teleportFailed do
                    task.wait(0.25)
                end
                if teleportFailed then
                    task.wait(2)
                end
            else
                if list and #list > 0 then
                    servers = {game.JobId}
                end
                task.wait(status == 429 and 20 or 5)
            end
        end
        hopping = false
    end)
end

local function doRejoin()
    if rejoining then return end
    rejoining = true
    task.spawn(function()
        local attempt = 0
        while rejoinEnabled do
            attempt += 1
            queueReload()
            pcall(function()
                if #Players:GetPlayers() <= 1 or attempt > 1 then
                    TeleportService:Teleport(game.PlaceId, player)
                else
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
                end
            end)
            task.wait(10)
        end
        rejoining = false
    end)
end

-- Anti-AFK is always on
local idledConn = player.Idled:Connect(function()
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end)

local promptConn
task.spawn(function()
    local promptGui = CoreGui:WaitForChild("RobloxPromptGui", 15)
    local overlay = promptGui and promptGui:WaitForChild("promptOverlay", 15)
    if overlay then
        promptConn = overlay.ChildAdded:Connect(function(child)
            if child.Name == "ErrorPrompt" and rejoinEnabled then
                doRejoin()
            end
        end)
    end
end)

local perfSaved = {}
local perfConns = {}
local perfQuality = nil

local function saveSet(inst, prop, value)
    local ok, old = pcall(function() return inst[prop] end)
    if ok then
        perfSaved[#perfSaved + 1] = {inst, prop, old}
        pcall(function() inst[prop] = value end)
    end
end

local function optimize(d)
    if d:IsA("Terrain") then return end
    if d:IsA("BasePart") then
        saveSet(d, "Material", Enum.Material.SmoothPlastic)
        saveSet(d, "Reflectance", 0)
        saveSet(d, "CastShadow", false)
    elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") or d:IsA("PostEffect") then
        saveSet(d, "Enabled", false)
    elseif d:IsA("Decal") then
        saveSet(d, "Transparency", 1)
    end
end

local function setPerformance(state)
    perfEnabled = state
    if state then
        task.spawn(function()
            saveSet(Lighting, "GlobalShadows", false)
            pcall(function()
                perfQuality = settings().Rendering.QualityLevel
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            end)
            pcall(function()
                saveSet(workspace.Terrain, "Decoration", false)
            end)

            local n = 0
            for _, root in ipairs({workspace, Lighting}) do
                for _, d in ipairs(root:GetDescendants()) do
                    if not perfEnabled then return end
                    optimize(d)
                    n += 1
                    if n % 400 == 0 then task.wait() end
                end
            end

            perfConns[#perfConns + 1] = workspace.DescendantAdded:Connect(function(d)
                if perfEnabled then optimize(d) end
            end)
            perfConns[#perfConns + 1] = Lighting.DescendantAdded:Connect(function(d)
                if perfEnabled then optimize(d) end
            end)
        end)
    else
        for _, c in ipairs(perfConns) do
            c:Disconnect()
        end
        perfConns = {}
        task.spawn(function()
            local n = 0
            for i = #perfSaved, 1, -1 do
                local e = perfSaved[i]
                pcall(function()
                    if e[1] and e[1].Parent ~= nil or e[1] == Lighting then
                        e[1][e[2]] = e[3]
                    end
                end)
                n += 1
                if n % 400 == 0 then task.wait() end
            end
            perfSaved = {}
            pcall(function()
                if perfQuality then
                    settings().Rendering.QualityLevel = perfQuality
                end
            end)
        end)
    end
end

