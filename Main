local function makeButton(text, y, height, size)
    local b = Instance.new("TextButton")
    b.Name = randName()
    b.Size = UDim2.new(1, -20, 0, height)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = size
    b.BorderSizePixel = 0
    b.Parent = frame
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    return b
end

local function paint(button, text, on)
    button.Text = text
    button.BackgroundColor3 = on and Color3.fromRGB(50, 170, 70) or Color3.fromRGB(180, 50, 50)
end

