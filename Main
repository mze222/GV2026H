local perfToggle = makeButton("Performance Mode: Off", 120, 34, 13)
local rejoinToggle = makeButton("Auto Rejoin On Kick: Off", 162, 30, 13)
local hopToggle = makeButton("Serverhop (Farm): Off", 198, 30, 13)

local function setEnabled(state)
    enabled = state
    runId += 1
    if enabled then
        paint(toggle, "Farm: On", true)
        startGuard()
        task.spawn(mainLoop, runId)
    else
        paint(toggle, "Farm: Off", false)
        stopGuard()
        local ok, _, hum, root = pcall(getCharacter)
        if ok and hum and root then
            hum:MoveTo(root.Position)
        end
    end
end

local function setPerfUI(state)
    setPerformance(state)
    paint(perfToggle, "Performance Mode: " .. (state and "On" or "Off"), state)
end

local function setRejoinUI(state)
    rejoinEnabled = state
    paint(rejoinToggle, "Auto Rejoin On Kick: " .. (state and "On" or "Off"), state)
end

local function setHopUI(state)
    hopEnabled = state
    paint(hopToggle, "Serverhop (Farm): " .. (state and "On" or "Off"), state)
end

toggle.MouseButton1Click:Connect(function()
    setEnabled(not enabled)
end)

perfToggle.MouseButton1Click:Connect(function()
    setPerfUI(not perfEnabled)
end)

rejoinToggle.MouseButton1Click:Connect(function()
    setRejoinUI(not rejoinEnabled)
end)

hopToggle.MouseButton1Click:Connect(function()
    setHopUI(not hopEnabled)
end)

fpsBox.FocusLost:Connect(function()
    local n = tonumber(fpsBox.Text)
    if n and setfpscap then
        setfpscap(math.floor(math.max(n, 0)))
    end
end)

local dragging = false
local dragStart, startPos

bar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

local dragConn = UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

local function shutdown()
    setEnabled(false)
    hopEnabled = false
    rejoinEnabled = false
    if perfEnabled then
        setPerformance(false)
    end
    pcall(function() houseConn:Disconnect() end)
    pcall(function() idledConn:Disconnect() end)
    pcall(function() dragConn:Disconnect() end)
    pcall(function() tpFailConn:Disconnect() end)
    pcall(function()
        if promptConn then promptConn:Disconnect() end
    end)
    pcall(function() gui:Destroy() end)
    clearQueue()
    genv.HHF_STATE = nil
    if genv.HHF_STOP == shutdown then
        genv.HHF_STOP = nil
    end
end

genv.HHF_STOP = shutdown

close.MouseButton1Click:Connect(shutdown)

if not canReload() then
    warn(("[HHF] Reload source missing. Set RELOAD_URL or save this script as %q in your executor workspace, otherwise serverhop/rejoin cannot restart the farm."):format(RELOAD_FILE))
end

if saved then
    if saved.perf then setPerfUI(true) end
    if saved.rejoin then setRejoinUI(true) end
    if saved.hop then setHopUI(true) end
    if saved.farm then
        task.spawn(function()
            repeat task.wait() until player.Character
            task.wait(2)
            setEnabled(true)
        end)
    end
end
